<comment>
problem   = a cloud in an isotropic far-ultraviolet field, by post-processing
reference = Kim, J.-G. et al. (2023) for the chemistry
configure = -ncr -shld_ci -shld_cr --prob=photchem_postproc

# A uniform sphere of 1000 H per cm^3, 2 pc in radius, in thin warm gas, lit from
# every side by one interstellar radiation field of Draine (1978).  The
# diffuse solver carries the field in from the faces of the box, and it and the NCR
# photochemistry are repeated in turn until the abundances stop changing.  The result
# is a cloud with an atomic envelope, a molecular interior, and carbon as C+, C and CO
# in nested shells.  About 230 iterations and 10 minutes on eight cores.
#
# To make it your own: <problem>/iprob = 2 is a Bonnor-Ebert sphere, iprob = 0 with
# density_file reads a density cube; iso_chi0 is the strength of the field;
# <rayt_diffuse>/angle_order sets the number of directions, 12 angle_order^2.
# The cooling table named by coolftn_file is inputs/tables/tigress_coolftn_ncr.txt;
# copy it beside the run.

<job>
problem_id = cloud

<output1>
file_type  = hst        # one row per iteration
dcycle     = 1

<output2>
file_type  = hdf5       # the whole box, before the first iteration and at the end
variable   = prim,uov
dt         = 1.0e30

# The plane of cells through the centre of the cloud, as text
<output3>
file_type  = tab
variable   = prim
x3_slice   = 0.046875
dt         = 1.0e30

<output4>
file_type  = tab
variable   = uov
x3_slice   = 0.046875
dt         = 1.0e30

<time>
cfl_number = 0.3
nlim       = -1         # <postproc>/niteration ends the run
tlim       = 1.0        # unused: the time stays at start_time
integrator = vl2
xorder     = 2
ncycle_out = 1
ops_task   = true       # the chemistry is stepped as an operator-split task

<postproc>
postproc        = true
niteration      = 1000     # the most iterations to take; 1000*dt = 10 code = 9.8 Myr,
                           # a few H2 formation times at n_H ~ 1e3
dt              = 1.0e-2   # step handed to the chemistry each iteration [code time,
                           # pc/(km/s) = 0.98 Myr]: short enough that the fronts move
                           # less than a cell between ray traces and the solver needs
                           # few substeps per cell
threshold_abund_mean = 3.0e-3  # relative change of x_HI, x_H2 and x_e, floored at
                               # abund_floor: its volume-weighted mean over the cells
threshold_abund_max  = -1.0    # the largest of any cell; off.  It stays above a per cent
                               # for 200 iterations here, held by a few cells at the surface
abund_floor     = 1.0e-3
threshold_temp  = 1.0e-2   # relative change of T/mu
threshold_rad   = 1.0e-2   # relative change of a band's energy density, summed over the box

<mesh>
nx1        = 64
x1min      = -3.0
x1max      = 3.0        # [pc]
ix1_bc     = outflow
ox1_bc     = outflow

nx2        = 64
x2min      = -3.0
x2max      = 3.0
ix2_bc     = outflow
ox2_bc     = outflow

nx3        = 64
x3min      = -3.0
x3max      = 3.0
ix3_bc     = outflow
ox3_bc     = outflow

refinement = none

<meshblock>
nx1        = 32
nx2        = 32
nx3        = 32

<hydro>
gamma      = 1.666666666667

<problem>
band_edge_um[3] = 0.36     # upper edges of the groups past the NCR bands [um]: the dust band set
band_edge_um[4] = 1.0
band_edge_um[5] = 3.0
iprob        = 1        # 0: uniform gas at nH0, or density_file; 1: a sphere of nH0 in gas
                        # of nH_amb; 2: a Bonnor-Ebert sphere of central density nH0 in it
nH0          = 1000.0   # [H cm^-3]
nH_amb       = 0.05     # [H cm^-3]; thin enough to be transparent
r_sphere     = 2.0      # [pc], iprob = 1 only
x1_sphere    = 0.046875 # centre of the cloud [pc]: the centre of a cell, so that the
x2_sphere    = 0.046875 # slice through it is a plane of cell centres
x3_sphere    = 0.046875
temp_be      = 30.0     # [K], iprob = 2 only: temperature of the isothermal sphere
mu_be        = 2.33     # iprob = 2 only: mean mass per particle [hydrogen masses]
xi_max       = 8.4      # iprob = 2 only: radius in units of c_s/sqrt(4 pi G rho_c), which
                        # is 0.238 pc here; 6.451 is the largest stable sphere
density_file =          # iprob = 0 only
temp0        = 100.0    # [K], before anything is solved
equil_init   = false    # start atomic
nsource      = 0        # no point sources
source_file  =
beam_chi0    = 0.0      # no beam
iso_chi0     = 1.0      # isotropic field, in units of the field isrf
isrf         = mmp83_draine11  # draine78, mmp83 or mmp83_draine11 (radiative_properties/isrf.hpp)
iso_phi_lyc  = 0.0      # ionizing part of it, one-sided photon flux [cm^-2 s^-1]

<rayt_point>
rayt_point  = false     # true, with <problem>/source_file, puts point sources in the box
rotate_rays = fixed     # a new ray orientation each trace would set a floor under the
                        # convergence test

<rayt_diffuse>
rayt_diffuse = true
scattering   = isotropic
eps_scatter[0] = 1.0      # 1 - albedo; 1 = pure absorption, so one formal solution a solve
eps_scatter[1] = 1.0
eps_scatter[2] = 1.0
angle_set    = healpix
angle_order  = 2          # nside; 48 directions
ray_bc       = open
ray_spacing  = 1.0
niteration   = 1

<photchem>
photchem = true
mode = ncr
bookkeeping = true
flag_op_split  = true
flag_rad_force = false
flag_update_dt_main = false
cfl_photchem = 1.0

<photchem_ncr>
dust_heating = absorbed   # dust heated by the power it absorbs over the transported bands
sed_average    = input
interp_mode = 1
cool_hyd_cie_flag = false
cool_dust_flag = true         # solve the dust temperature and couple it to the gas
h2_diss_bg_flag = false
kgr_H2_flag = false           # grain H2 formation at 3e-17 cm^3 s^-1 whatever the temperature
kgr_H2      = 3.0e-17
nsub_max = 50
cfl_cool_sub = 0.1
temp_hot0 = 20000.0
temp_hot1 = 35000.0
z_gas = 1.0
z_dust = 1.0
chi0 = 0.0                    # no untraced background: the traced field is all the light
xi_cr0 = 2e-16
shld_xi_cr_flag = true        # xi_cr falls as 1/N past shld_column_hyd_cr0; with -shld_cr
                              # N is the column the traced photoelectric field implies
shld_len0 = 0.0
shld_n_hyd0 = 1e2
shld_pow_idx = -0.7
shld_column_hyd_cr0 = 9.35e20
coolftn_file = tigress_coolftn_ncr.txt

# Cross sections and photon energies in the (LyC, LW, PE) bands, per H at Z_dust = 1
hnu[0]         = 18.0
sigma_d[0]     = 1.0e-21
sigma_pi_HI[0] = 3.1e-18
sigma_pi_H2[0] = 4.6e-18
hnu[1]         = 12.2
sigma_d[1]     = 2.0e-21
sigma_pi_HI[1] = 0.0
sigma_pi_H2[1] = 0.0
hnu[2]         = 9.0
sigma_d[2]     = 1.0e-21
sigma_pi_HI[2] = 0.0
sigma_pi_H2[2] = 0.0

<photchem_gow17>
# GOW17 photochemistry (configure -gow17, <photchem>/mode = gow17) under the same light
# as <photchem_ncr>: no untraced background, the same cosmic-ray attenuation and bands.
semi_implicit_gauss_seidel = true
semi_implicit_n_substep_max = 2000
semi_implicit_cfl_first = 1.0  # the first call relaxes the initial abundances; half the
                               # substeps of the run, final state within 0.1 per cent
is_kgrH2_const = true      # grain H2 formation at a constant rate, as kgr_H2_flag = false
chi0           = 0.0
xi_cr0         = 2e-16
shld_xi_cr_flag = true
shld_column_hyd_cr0 = 9.35e20
h2_diss_bg_flag = false
z_gas          = 1.0
z_dust         = 1.0
per_channel_dust = true    # each photo-rate scaled by its own GOW17 dust factor; false
                           # leaves the traced field's single LW attenuation, as NCR
                           # (rayt_point/pdr_sphere sets false to test the tracer alone)
coolftn_file   = tigress_coolftn_ncr.txt
sed_average    = input
hnu[0]         = 18.0
sigma_d[0]     = 1.0e-21
sigma_pi_HI[0] = 3.1e-18
sigma_pi_H2[0] = 4.6e-18
hnu[1]         = 12.2
sigma_d[1]     = 2.0e-21
sigma_pi_HI[1] = 0.0
sigma_pi_H2[1] = 0.0
hnu[2]         = 9.0
sigma_d[2]     = 1.0e-21
sigma_pi_HI[2] = 0.0
sigma_pi_H2[2] = 0.0

<dust>
dust  = true               # dust band averages; photchem gets sigma_abs_d[g]
model = /Users/jgkim/Projects/tigris-data/dust/zubko04-bare-gr-s
