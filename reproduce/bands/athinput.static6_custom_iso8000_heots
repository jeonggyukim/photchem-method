<comment>
problem   = hii region
reference =
configure = --prob=hii --nscalars=1

<job>
problem_id = HII
output_timing = true

<output1>
file_type  = hst        # History data dump
dt         = 1e-4       # time increment between outputs

<output2>
file_type  = hdf5       # HDF5 data dump
variable   = prim,uov   # variables to be output [prim, cons]
dt         = 2e-2       # time increment between outputs

<output3>
file_type  = rst        # Restart data dump
dt         = 2e-1       # time increment between outputs

<time>
cfl_number = 0.3        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1         # cycle limit
tlim       = 3.0e0      # time limit
integrator  = rk2       # time integration algorithm
xorder      = 2         # order of spatial reconstruction
ncycle_out  = 1         # interval for stdout summary info
dt_diagnostics = 0
ops_task = true

<mesh>
nx1        = 64         # Number of zones in X1-direction
x1min      = -18        # minimum value of X1
x1max      =  18        # maximum value of X1
ix1_bc     = user       # inner-X1 boundary flag
ox1_bc     = user       # outer-X1 boundary flag

nx2        = 64         # Number of zones in X2-direction
x2min      = -18        # minimum value of X2
x2max      =  18        # maximum value of X2
ix2_bc     = user       # inner-X2 boundary flag
ox2_bc     = user       # outer-X2 boundary flag

nx3        = 64         # Number of zones in X3-direction
x3min      = -18        # minimum value of X3
x3max      =  18        # maximum value of X3
ix3_bc     = user       # inner-X3 boundary flag
ox3_bc     = user       # outer-X3 boundary flag

refinement = none

<meshblock>
nx1        = 32
nx2        = 32
nx3        = 32

<hydro>
active     = fixed      # static sphere: gas held, chemistry and energy evolve
gamma           = 1.666666666667 # gamma = C_p/C_v
neighbor_flooring = true
fofc              = true

<problem>
nH0        = 100.0    # Number density of H [H/cm^-3]
nH0_amb    = 100.0    # Number density of H for r > r0 [H/cm^-3]
r0         = 9.0      # Set density to nH0_amb if r > r0 [code]
x1_src     = 0.0      # x1 source position [code]
x2_src     = 0.0      # x2 source position [code]
x3_src     = 0.0      # x3 source position [code]
t0_src     = 0.0      # Time at which source is turned on [code]
Qi         = 1e49     # Ionizing photon rate [1/s]
Ln_over_Li = 0.0      # Ratio between FUV and EUV luminosities
amp_den    = 0.0      # Amplitude of density perturbation (non zero to turn on)
turb_flag  = 0        # Velocity perturbation (1 to turn on)
v3d        = 5.0      # 3D velocity dispersion [code]
dedt       = 0.0
t0_refine  = 0.0      # Turn on refinement after t0 [code]
thr        = 1.0      # gradient threshold for AMR

<perturbation>
nlow          = 2
nhigh         = 64
expo          = 2
rseed         = 1

<rayt_point>
rayt_point = true      # true or false
rays_per_cell = 4.0     # Nominal angular resolution (can be a real number)
healpix_lev_min = 4     # HealPix level at creation
nexit_max = 100         # Maximum number of rays to send to neighbor ranks (MPI only)
tau_max = 30.0          # Stop following a ray if tau > tau_max at all freq bins
rotate_rays = true      # Random rotation of ray directions: true (new each trace), fixed (one for the run), false

<photchem>
photchem = true
mode = gow17               # Mode of photochemistry [simple,ncr,gow17]
bookkeeping = true         # Keep track of net creation term for HI (add uov to <output2>/type)
flag_op_split  = true      # Operator split update
flag_rad_force = false     # Turn on radiation pressure force (Simple and NCR modes)
flag_update_dt_main = true # Update dt_main using dt_user=dt_coolchem
cfl_photchem = 1.0         # dt_user = cfl_photchem*t_coolchem

<photchem_simple>
sed_average    = input     # input: read hnu/sigma_d/sigma_pi below
                           # computed: band-average them at startup from sed_file over the
                           # edges of band_set, and write them back here
tgas_HII       = 8000.0    # Temperature of fully ionized gas [K]
tgas_HI        = 100.0     # Temperature of fully neutral gas [K]
f_dt_rad       = 0.1       # Ensure less than 10% change in x_n per photchem update

# Cross sections and photon energies in (LyC,FUV) bands
hnu[0]         = 18.0      # SED-averaged energy of photons [eV]
sigma_d[0]     = 0.0       # Mean dust extinction cross section [cm^2/H]
sigma_pi_HI[0] = 3.0e-18   # Mean photoionization cross section [cm^2/H]
hnu[1]         = 9.0       # SED-averaged energy of photons [eV]
sigma_d[1]     = 1e-21     # Mean dust extinction cross section [cm^2/H]
sigma_pi_HI[1] = 0.0       # SED-averaged energy of photons [eV]

<photchem_ncr>
sed_average    = input     # input: read hnu/sigma_d/sigma_pi below
                           # computed: band-average them at startup from sed_file over the
                           # edges of band_set, and write them back here
interp_mode = 0               # 0=kExact, 1=kLogLog, 2=kNqt2, 3=kNqt1
cool_hyd_cie_flag = false
cool_dust_flag = false
h2_diss_bg_flag = false
nsub_max = 50
cfl_cool_sub = 0.1
temp_hot0 = 20000.0
temp_hot1 = 35000.0
z_gas = 1.0
z_dust = 1.0
chi0 = 1.0
xi_cr0 = 2e-16
shld_len0 = 0.0               # zero to turn off
shld_n_hyd0 = 1e2
shld_pow_idx = -0.7
shld_column_hyd_cr0 = 9.35e20
coolftn_file = tigress_coolftn_ncr.txt  # file name for high-T cooling table

# Cross sections and photon energies in (LyC,LW,PE) bands
# sigma_d is per H at Z_dust = 1 (scaled by z_dust)
hnu[0]      = 18.0
sigma_d[0]     = 1.0e-21 # smaller than theoretical estimate
sigma_pi_HI[0] = 3.1e-18
sigma_pi_H2[0] = 4.6e-18
hnu[1]      = 12.2
sigma_d[1]     = 2.0e-21
sigma_pi_HI[1] = 0.0
sigma_pi_H2[1] = 0.0
hnu[2]         = 9.0
sigma_d[2]     = 1e-21
sigma_pi_HI[2] = 0.0
sigma_pi_H2[2] = 0.0

<photchem_gow17>
z_dust         = 0.0
GOW17_Z_d      = 0.0
he_recombination = on_the_spot
GOW17_temperature_fixed = 8000.0
semi_implicit_gauss_seidel = true
chi0           = 0.0
xi_cr0         = 0.0
h2_diss_bg_flag = false
sed_average    = computed
sed_format     = table
sed_file       = ${TIGRIS_DIR}/inputs/tables/sed/sb99_Z014_GenevaV00_2Myr.txt
photoion_xsec_file = ${TIGRIS_DIR}/inputs/tables/rates/verner96_photx.dat
sigma_d[0]     = 1.0e-21
sigma_d[1]     = 1.0e-21
sigma_d[2]     = 1.0e-21
sigma_d[3]     = 2.0e-21
sigma_d[4]     = 2.0e-21
sigma_d[5]     = 1.0e-21
band_set       = custom
band_edge[0]   = O1
band_edge[1]   = He0
band_edge[2]   = S1
band_edge[3]   = 912.0
band_edge[4]   = 1108.0
band_edge[5]   = 2066.4
rates_dir      = ${TIGRIS_DIR}/inputs/tables/rates
coolftn_file   = ${TIGRIS_DIR}/inputs/tables/tigress_coolftn_ncr.txt
