# Large or machine-specific files, which are not tracked.
# The reduced arrays a figure plots are tracked beside its script
# (tests/<problem>/fig_<name>/reduced*.txt).
*.vtk
*.athdf
*.hdf5
*.h5
*.key
__pycache__/
.ipynb_checkpoints/
.DS_Store

# This machine's settings: a copy of one of tests/machines/*.sh.
tests/machine.sh

# Figure output: the scripts are tracked, the figures they write are not. Each
# script creates figures/ if it is missing; it may also be a link to a synced folder.
/figures

# Raw simulation output never enters this repository. The runs live in
# $PHOTCHEM_RUNS, and $PHOTCHEM_DATA_DIR holds the large reduced arrays of
# tests/pdr_sphere.
data/
*.diffuse
*.npz

# Python environments and build products from pip install.
.venv/
*.egg-info/
build/
