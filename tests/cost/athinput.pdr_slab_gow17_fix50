<comment>
problem   = plane-parallel photodissociation region by post-processing
reference = Kim, J.-G. et al. (2023) section 7.2 and figure 10; Gong, Ostriker & Wolfire (2017)
configure = -gow17 -shld_ci -shld_co -shld_cr --prob=photchem_postproc
# athinput.pdr_slab with GOW17 photochemistry: <photchem>/mode = gow17 and the
# <photchem_gow17> block at the end, which carries the same bands and fields.

# A uniform slab lit through its inner x1 face by a far-ultraviolet beam, with the
# radiation field, the abundances and the temperature brought into agreement by
# repeating the diffuse solver and the NCR photochemistry in turn.  The mesh is one
# dimensional in all but name: 4096 cells of 0.01 pc along the beam, the cell size
# of the paper's model at this density, and two across, which is the least a
# MeshBlock can hold with two ghost cells.  The slab ends at a column of
# 1.26e22 cm^-2, A_V = 6.8.
#
# The beam is one direction of a HEALPix set, the one along +x1; the other eleven
# carry nothing.  beam_chi0 is the field at the lit face in units of Draine (1978),
# in the Lyman-Werner and the photoelectric band alike.
#
# -shld_ci makes rays follow the column of neutral carbon, without which the C I
# ionizing field is attenuated by dust alone and carbon stays ionized far too deep.
# The cooling table named by coolftn_file is inputs/tables/tigress_coolftn_ncr.txt;
# copy it beside the run.

<job>
problem_id = pdr_gow17

<output1>
file_type  = hst        # one row per iteration
dcycle     = 1

<output2>
file_type  = hdf5       # the state before the first iteration and the converged one
variable   = prim,uov
dt         = 1.0e30

# The same along one line of cells down the beam, as text, which needs no HDF5:
# density, pressure and abundances in the first, and in the second what the
# chemistry sees in each cell, written by the problem generator.
<output3>
file_type  = tab
variable   = prim
x2_slice   = 0.005
x3_slice   = 0.005
dt         = 1.0e30

<output4>
file_type  = tab
variable   = uov
x2_slice   = 0.005
x3_slice   = 0.005
dt         = 1.0e30

<time>
cfl_number = 0.3
nlim       = -1         # <postproc>/niteration ends the run
tlim       = 1.0        # unused: the time stays at start_time
integrator = vl2
xorder     = 2
ncycle_out = 1
ops_task   = true       # the chemistry is stepped as an operator-split task

<postproc>
postproc        = true
niteration      = 300      # the most iterations to take
dt              = 1.0e6    # step handed to the chemistry each iteration [code time]
threshold_abund_mean = 1.0e-3  # relative change of x_HI, x_H2 and x_e, floored at
                               # abund_floor: its volume-weighted mean over the cells
threshold_abund_max  = -1.0    # the largest of any cell; off
abund_floor     = 1.0e-3
threshold_temp  = 1.0e-2   # relative change of T/mu
threshold_rad   = 1.0e-2   # relative change of a band's energy density, summed over the box

<mesh>
nx1        = 4096
x1min      = 0.0
x1max      = 40.96      # [pc]
ix1_bc     = outflow
ox1_bc     = outflow

nx2        = 2
x2min      = -0.01
x2max      = 0.01
ix2_bc     = outflow
ox2_bc     = outflow

nx3        = 2
x3min      = -0.01
x3max      = 0.01
ix3_bc     = outflow
ox3_bc     = outflow

refinement = none

<meshblock>
nx1        = 512
nx2        = 2
nx3        = 2

<hydro>
gamma      = 1.666666666667

<problem>
nH0          = 100.0    # [H cm^-3]
density_file =          # empty: uniform at nH0
temp0        = 100.0    # [K], before anything is solved
equil_init   = false    # start atomic, so the first trace sees no H2 column
nsource      = 0        # no point sources; the beam is the only light
source_file  =
beam_chi0    = 1.0      # field at the lit face, in units of Draine (1978)
beam_first_cell = false # true: beam_chi0 is the average over the first cell instead,
                        # the convention of the Athena-TIGRESS six-ray test

<rayt_point>
rayt_point = false

<rayt_diffuse>
rayt_diffuse = true
scattering   = isotropic
eps_scatter[0] = 1.0      # 1 - albedo; 1 = pure absorption, so one formal solution a solve
eps_scatter[1] = 1.0
eps_scatter[2] = 1.0
g_scatter[0] = 0.0
g_scatter[1] = 0.0
g_scatter[2] = 0.0
src_emit[0]  = 0.0
src_emit[1]  = 0.0
src_emit[2]  = 0.0
acceleration = none
lattice      = face
interpolate  = false
angle_set    = healpix    # holds the direction (1, 0, 0), which the beam needs
angle_order  = 1
angle_rotate_seed = 0
chi_const    = 0.0
src_const    = 0.0
intensity_bc = 0.0        # replaced by the beam the problem generator enrolls
ray_bc       = open
ray_spacing  = 1.0
niteration   = 1
threshold    = -1.0

<photchem>
photchem = true
mode = gow17
bookkeeping = false
flag_op_split  = true
flag_rad_force = false
flag_update_dt_main = false
cfl_photchem = 1.0

<photchem_ncr>
sed_average    = input
interp_mode = 0
cool_hyd_cie_flag = false
cool_dust_flag = false
h2_diss_bg_flag = false
kgr_H2_flag = false           # grain H2 formation at 3e-17 cm^3 s^-1 whatever the temperature,
kgr_H2      = 3.0e-17         # as in every test of section 7
nsub_max = 50
cfl_cool_sub = 0.1
temp_hot0 = 20000.0
temp_hot1 = 35000.0
z_gas = 1.0
z_dust = 1.0
chi0 = 0.0                    # no background field: the beam is the only far-ultraviolet light
xi_cr0 = 2e-16
shld_xi_cr_flag = false       # the cosmic-ray rate does not fall with column. true makes it
                              # fall as 1/N past shld_column_hyd_cr0, as in figure 10; with
                              # -shld_cr N is the column the traced photoelectric field implies
shld_len0 = 0.0
shld_n_hyd0 = 1e2
shld_pow_idx = -0.7
shld_column_hyd_cr0 = 9.35e20
coolftn_file = tigress_coolftn_ncr.txt

# Cross sections and photon energies in the (LyC, LW, PE) bands, per H at Z_dust = 1;
# the dust values are those of the Athena-TIGRESS run behind figure 10
hnu[0]         = 18.0
sigma_d[0]     = 1.0e-21
sigma_pi_HI[0] = 3.1e-18
sigma_pi_H2[0] = 4.6e-18
hnu[1]         = 12.2
sigma_d[1]     = 2.0e-21
sigma_pi_HI[1] = 0.0
sigma_pi_H2[1] = 0.0
hnu[2]         = 9.0
sigma_d[2]     = 1.0e-21
sigma_pi_HI[2] = 0.0
sigma_pi_H2[2] = 0.0

<photchem_gow17>
semi_implicit_gauss_seidel = true
# Each postproc iteration hands the chemistry <postproc>/dt; the integration stops at
# this many substeps, which makes an iteration a bounded relaxation step.
semi_implicit_n_substep_max = 2000
semi_implicit_n_substep_fixed = 50
is_kgrH2_const = true      # grain H2 formation at a fixed rate, as kgr_H2_flag = false
chi0           = 0.0       # no background field: the beam is the only far-ultraviolet light
xi_cr0         = 2e-16
shld_xi_cr_flag = false    # as <photchem_ncr>; true with -shld_cr attenuates the rate
shld_column_hyd_cr0 = 9.35e20  # as 1/N past this column [cm^-2]
h2_diss_bg_flag = false
z_gas          = 1.0
z_dust         = 1.0
sed_average    = input
hnu[0]         = 18.0
sigma_d[0]     = 1.0e-21
sigma_pi_HI[0] = 3.1e-18
sigma_pi_H2[0] = 4.6e-18
hnu[1]         = 12.2
sigma_d[1]     = 2.0e-21
sigma_pi_HI[1] = 0.0
sigma_pi_H2[1] = 0.0
hnu[2]         = 9.0
sigma_d[2]     = 1.0e-21
sigma_pi_HI[2] = 0.0
sigma_pi_H2[2] = 0.0
