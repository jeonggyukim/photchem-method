<comment>
problem   = a static Stromgren sphere, by post-processing
reference = Cloudy 25.00 runs of tests/hii_static/blackbody/run_cloudy_bb.sh (from
            hii.in and thermal_with_N_ots/hii.in, with the same spectrum)
configure = -mpi -gow17 --photchem_ions=O3,S3,N3 --gow17_bands=8 --ngroup_rayt_diffuse=12 --prob=photchem_postproc -hdf5

# One point source of 1e49 ionizing photons per second at the centre of a uniform
# box of 100 H per cm^3, 12 pc on a side. The spectrum is <photchem_gow17>/sed_file:
# the Starburst99 spectrum at 2 Myr below, or a blackbody of ../blackbody (set on the
# command line by run_tigris.sh). The gas is held fixed. The point-source ray
# tracer and the GOW17 chemical network with the O, S and N ions and He++ are
# repeated in turn until the abundances stop changing. No dust, no cosmic rays and
# no far-ultraviolet background.
#
# <photchem_gow17>/recombination_ots sets where the recombination photons go: true
# absorbs them on the spot (H case B); false sends them through the diffuse ray tracer
# (H and He case A). run_tigris.sh runs both for each spectrum.

<job>
problem_id = cloud

<output1>
file_type  = hst        # one row per iteration
dcycle     = 1

<output2>
file_type  = hdf5       # the whole box, before the first iteration and at the end
variable   = prim,uov
dt         = 1.0e30

# The plane of cells through the centre of the cloud, as text
<output3>
file_type  = tab
variable   = prim
x3_slice   = 0.046875
dt         = 1.0e30

<output4>
file_type  = tab
variable   = uov
x3_slice   = 0.046875
dt         = 1.0e30

<time>
cfl_number = 0.3
nlim       = -1         # <postproc>/niteration ends the run
tlim       = 1.0        # unused: the time stays at start_time
integrator = vl2
xorder     = 2
ncycle_out = 1
ops_task   = true       # the chemistry is stepped as an operator-split task

<postproc>
postproc        = true
niteration = 400
dt              = 0.002    # step handed to the chemistry each iteration [code time]
threshold_abund_mean = 1.0e-3  # relative change of x_HI, x_H2 and x_e, floored at
                               # abund_floor: its volume-weighted mean over the cells
threshold_abund_max  = -1.0    # the largest of any cell; off.  It stays above a per cent
                               # for 200 iterations here, held by a few cells at the surface
abund_floor     = 1.0e-3
threshold_temp  = 1.0e-2   # relative change of T/mu
threshold_rad   = 1.0e-2   # relative change of a band's energy density, summed over the box

<mesh>
nx1        = 64
x1min = -6.0
x1max = 6.0
ix1_bc     = outflow
ox1_bc     = outflow

nx2        = 64
x2min = -6.0
x2max = 6.0
ix2_bc     = outflow
ox2_bc     = outflow

nx3        = 64
x3min = -6.0
x3max = 6.0
ix3_bc     = outflow
ox3_bc     = outflow

refinement = none

<meshblock>
nx1        = 32
nx2        = 32
nx3        = 32

<hydro>
gamma      = 1.666666666667

<problem>
iprob = 0               # 0: uniform gas at nH0; 1: a sphere of nH0 in gas of nH_amb;
                        # 2: a Bonnor-Ebert sphere of central density nH0 in it
nH0 = 100.0
nH_amb       = 0.05     # [H cm^-3]; thin enough to be transparent
r_sphere     = 2.0      # [pc], iprob = 1 only
x1_sphere    = 0.046875 # centre of the cloud [pc]: the centre of a cell, so that the
x2_sphere    = 0.046875 # slice through it is a plane of cell centres
x3_sphere    = 0.046875
temp_be      = 30.0     # [K], iprob = 2 only: temperature of the isothermal sphere
mu_be        = 2.33     # iprob = 2 only: mean mass per particle [hydrogen masses]
xi_max       = 8.4      # iprob = 2 only: radius in units of c_s/sqrt(4 pi G rho_c), which
                        # is 0.238 pc here; 6.451 is the largest stable sphere
density_file =          # iprob = 0 only
temp0 = 100.0
equil_init   = false    # start atomic
# heating and cooling by process in every cell (user output variables heat_*, cool_*),
# and two probe cells, written to cloud.probe<n>.txt: the terms over probe_nt
# temperatures with the cell's abundances and radiation held fixed. The source is at
# the origin; the probes hold r = 1.0 and 2.5 pc on the (1,1,1) diagonal, at
# x1 = x2 = x3 = r/sqrt(3) (cell centres at 1.14 and 2.44 pc).
rates_by_process = true
n_probe      = 2
probe0_x1    = 0.57735027
probe0_x2    = 0.57735027
probe0_x3    = 0.57735027
probe1_x1    = 1.44337567
probe1_x2    = 1.44337567
probe1_x3    = 1.44337567
probe_tmin   = 1.0e3    # [K]
probe_tmax   = 3.0e4
probe_nt     = 141
nsource = 1
source_file  =
beam_chi0 = 0.0
iso_chi0 = 0.0
iso_phi_lyc  = 0.0      # ionizing part of it, one-sided photon flux [cm^-2 s^-1]
src1_x1 = 0.0
src1_x2 = 0.0
src1_x3 = 0.0
src1_Q_LyC = 1e49
src1_L_LW = 0.0
src1_L_PE = 0.0
fuv_from_sed = true

<rayt_point>
tau_max       = 20      # optical depth at which a ray stops
rays_per_cell = 20      # rays crossing each cell, which sets the HEALPix level
rayt_point = true
rotate_rays = fixed     # a new ray orientation each ray-tracing pass would set a floor under the
                        # convergence test

<rayt_diffuse>
rayt_diffuse = false
scattering   = isotropic
eps_scatter  = 1.0        # 1 - albedo, every group; 1 = pure absorption, one formal solution
angle_set    = healpix
angle_order  = 2          # nside; 48 directions
ray_bc       = open
ray_spacing  = 1.0
niteration   = 1

<photchem>
photchem = true
mode = gow17
bookkeeping = true
flag_op_split  = true
flag_rad_force = false
flag_update_dt_main = false
cfl_photchem = 1.0

<photchem_gow17>
z_dust         = 0.0
recombination_ots = true  # false: H and He case A, photons through the diffuse ray tracer
ion_cooling_dir = ${TIGRIS_DIR}/inputs/tables/chianti_v11/ion_cooling
semi_implicit_gauss_seidel = true
chi0           = 0.0
xi_cr0         = 0.0
h2_diss_bg_flag = false
sed_average    = computed
sed_format     = table
sed_file       = ${TIGRIS_DIR}/inputs/tables/sed/sb99_Z014_GenevaV00_2Myr.txt
photoion_xsec_file = ${TIGRIS_DIR}/inputs/tables/rates/verner96_photx.dat
sigma_d[0]     = 1.0e-21
sigma_d[1]     = 1.0e-21
sigma_d[2]     = 1.0e-21
sigma_d[3]     = 2.0e-21
sigma_d[4]     = 2.0e-21
sigma_d[5]     = 1.0e-21
sigma_d[6]     = 1.0e-21
sigma_d[7]     = 1.0e-21
sigma_d[8]     = 1.0e-21  # one entry per band (10 bands); unused with z_dust = 0
sigma_d[9]     = 1.0e-21
rates_dir      = ${TIGRIS_DIR}/inputs/tables/rates
coolftn_file   = ${TIGRIS_DIR}/inputs/tables/tigress_coolftn_ncr.txt
