<comment>
problem   = expanding H II region (D-type), with the conditions of ../../hii_static
reference = Spitzer (1978); Hosokawa & Inutsuka (2006)
configure = -mpi -gow17 --photchem_ions=O3,S3,N3 --gow17_bands=8 --prob=hii -hdf5

# One point source of 1e49 ionizing photons per second (Starburst99 at 2 Myr) turned on
# at t = 0 at the centre of uniform gas of 100 H per cm^3, 24 pc on a side, with
# hydrodynamics. As ../../hii_static (0.1875 pc cells, the same spectrum, abundances
# and chemical network: GOW17 with the O, S and N ions and He++, 8 bands), no dust,
# and the recombination photons absorbed on the spot; unlike hii_static, a uniform
# far-ultraviolet field (chi0 = 1) and cosmic rays (2e-16 s^-1 per H) heat the neutral
# gas. The Stromgren radius is 2.9 pc and the Spitzer radius about
# 9 pc at 1 Myr, inside the box. Time is in the code unit, 0.978 Myr.

<job>
problem_id = HII
output_timing = true

<output1>
file_type  = hst        # History data dump
dt         = 1e-3       # time increment between outputs

<output2>
file_type  = hdf5       # HDF5 data dump, one movie frame each
variable   = prim,uov   # variables to be output [prim, cons]
dt         = 2e-2       # time increment between outputs

<output3>
file_type  = rst        # Restart data dump
dt         = 2e-1       # time increment between outputs

<time>
cfl_number = 0.3        # The Courant, Friedrichs, & Lewy (CFL) Number
nlim       = -1         # cycle limit
tlim       = 1.0        # time limit [0.978 Myr]
integrator  = rk2       # time integration algorithm
xorder      = 2         # order of spatial reconstruction
ncycle_out  = 10        # interval for stdout summary info
dt_diagnostics = 0
ops_task = true

<mesh>
nx1        = 128        # Number of zones in X1-direction
x1min      = -12        # minimum value of X1 [pc]
x1max      =  12        # maximum value of X1
ix1_bc     = user       # inner-X1 boundary flag
ox1_bc     = user       # outer-X1 boundary flag

nx2        = 128
x2min      = -12
x2max      =  12
ix2_bc     = user
ox2_bc     = user

nx3        = 128
x3min      = -12
x3max      =  12
ix3_bc     = user
ox3_bc     = user

refinement = none

<meshblock>
nx1        = 32
nx2        = 32
nx3        = 32

<hydro>
gamma           = 1.666666666667 # gamma = C_p/C_v
neighbor_flooring = true
fofc              = true

<problem>
nH0        = 100.0    # Number density of H [H/cm^-3]
nH0_amb    = 100.0    # Number density of H for r > r0 [H/cm^-3]
r0         = 100.0    # uniform: r0 beyond the box
x1_src     = 0.0      # x1 source position [code]
x2_src     = 0.0      # x2 source position [code]
x3_src     = 0.0      # x3 source position [code]
t0_src     = 0.0      # Time at which source is turned on [code]
Qi         = 1e49     # Ionizing photon rate [1/s]
Ln_over_Li = 0.0      # Ratio between FUV and EUV luminosities
amp_den    = 0.0      # Amplitude of density perturbation (non zero to turn on)
turb_flag  = 0        # Velocity perturbation (1 to turn on)
v3d        = 5.0      # 3D velocity dispersion [code]
dedt       = 0.0
t0_refine  = 0.0      # Turn on refinement after t0 [code]
thr        = 1.0      # gradient threshold for AMR

<perturbation>
nlow          = 2
nhigh         = 64
expo          = 2
rseed         = 1

<rayt_point>
rayt_point = true      # true or false
rays_per_cell = 4.0     # Nominal angular resolution (can be a real number)
healpix_lev_min = 4     # HealPix level at creation
nexit_max = 100         # Maximum number of rays to send to neighbor ranks (MPI only)
tau_max = 30.0          # Stop following a ray if tau > tau_max at all freq bins
rotate_rays = true      # Random rotation of ray directions: true (new each ray-tracing pass), fixed (one for the run), false

<photchem>
photchem = true
mode = gow17               # Mode of photochemistry [simple,ncr,gow17]
bookkeeping = true         # Keep track of net creation term for HI (add uov to <output2>/type)
flag_op_split  = true      # Operator split update
flag_rad_force = false     # Turn on radiation pressure force (Simple and NCR modes)
flag_update_dt_main = true # Update dt_main using dt_user=dt_coolchem
cfl_photchem = 10.0        # dt_user = cfl_photchem*t_coolchem, as ../ions_7bands

<photchem_gow17>
z_dust         = 0.0       # no dust
chi0           = 1.0       # uniform far-ultraviolet field [Draine]
xi_cr0         = 2e-16     # cosmic-ray ionization rate per H [s^-1]
h2_diss_bg_flag = false
recombination_ots = true   # recombination photons absorbed on the spot (H case B)
semi_implicit_gauss_seidel = true
ion_cooling_dir = ${TIGRIS_DIR}/inputs/tables/chianti_v11/ion_cooling
rates_dir      = ${TIGRIS_DIR}/inputs/tables/rates
coolftn_file   = ${TIGRIS_DIR}/inputs/tables/tigress_coolftn_ncr.txt
sed_average    = computed
sed_format     = table
sed_file       = ${TIGRIS_DIR}/inputs/tables/sed/sb99_Z014_GenevaV00_2Myr.txt
photoion_xsec_file = ${TIGRIS_DIR}/inputs/tables/rates/verner96_photx.dat
sigma_d[0]     = 1.0e-21   # one entry per band (8 bands); unused with z_dust = 0
sigma_d[1]     = 1.0e-21
sigma_d[2]     = 1.0e-21
sigma_d[3]     = 2.0e-21
sigma_d[4]     = 2.0e-21
sigma_d[5]     = 1.0e-21
sigma_d[6]     = 1.0e-21
sigma_d[7]     = 1.0e-21
